#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Input { uint src[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { uint dst[]; };
layout(push_constant) uniform Layout {
  uint width,height,src_stride,src_rows,dst_stride,dst_rows,depth;
} p;
void main() {
  uint x=gl_GlobalInvocationID.x*4u, row=gl_GlobalInvocationID.y;
  bool chroma=row>=p.height;
  uint width=chroma?((p.width+1u)&~1u):p.width;
  if(x>=width || row>=p.height+(p.height+1u)/2u)return;
  uint y=chroma?row-p.height:row;
  uint base=(y+(chroma?p.src_rows:0u))*p.src_stride;
  uint packed;
  if(p.depth==8u) {
    packed=src[(base+x)/4u];
  } else {
    // Four 10-bit samples span at most two uints; load each word once.
    uint bit=x*10u, index=base/4u+bit/32u, shift=bit%32u;
    uint a=src[index], b=0u;
    if(shift+min(4u,width-x)*10u>32u)b=src[index+1u];
    uint low=shift==0u?a:((a>>shift)|(b<<(32u-shift)));
    uint high=shift==0u?b:(b>>shift);
    uvec4 values=uvec4(low,low>>10u,low>>20u,(low>>30u)|(high<<2u))&uvec4(1023u);
    // x is a multiple of four. Luma alternates per sample; chroma
    // alternates per interleaved UV pair, independently of word index.
    uvec4 threshold;
    if((y&1u)==0u)threshold=chroma?uvec4(0u,0u,2u,2u):uvec4(0u,2u,0u,2u);
    else threshold=chroma?uvec4(3u,3u,1u,1u):uvec4(3u,1u,3u,1u);
    values=min(uvec4(255u),(values+threshold)>>2u);
    packed=values.x|(values.y<<8u)|(values.z<<16u)|(values.w<<24u);
  }
  if(width-x<4u)packed&=(1u<<((width-x)*8u))-1u;
  dst[((y+(chroma?p.dst_rows:0u))*p.dst_stride+x)/4u]=packed;
}
